# --- PostgreSQL ---
POSTGRES_USER=boardgame_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=boardgame_db
POSTGRES_HOST_PORT=5433

# App-level connection (used by backend inside docker network)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- RustFS root (bootstrap only — NEVER used by backend) ---
RUSTFS_ACCESS_KEY=boardgame_admin
RUSTFS_SECRET_KEY=change_me_strong_password
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# --- RustFS service account (created by rustfs-init, used by backend) ---
RUSTFS_APP_ACCESS_KEY=boardgame_app_writer
RUSTFS_APP_SECRET_KEY=change_me_app_secret_min_8_chars

# --- S3 client for backend (same values as MINIO_APP_*, no $ interpolation) ---
S3_ENDPOINT=rustfs:9000
S3_ACCESS_KEY=boardgame_app_writer
S3_SECRET_KEY=change_me_app_secret_min_8_chars
S3_BUCKET=board-game-covers
S3_SECURE=false

# --- Public URL for cover links (browser-facing, no bucket inside) ---
PUBLIC_BASE_URL=http://localhost:9000

# --- Upload limits ---
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/webp"]

# --- Backend host port ---
BACKEND_PORT=8000